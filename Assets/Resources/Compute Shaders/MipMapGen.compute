#pragma kernel ReduceMaxMip

Texture2DArray<float> _SrcTex;
SamplerState sampler_SrcTex;
RWTexture2DArray<float> _DstTex;

int _SrcMipSizeX;
int _SrcMipSizeY;
int _SrcMip;
int _SrcSlice;
int _DstSlice;

[numthreads(8, 8, 1)]
void ReduceMaxMip(uint3 id : SV_DispatchThreadID)
{
    // Each thread computes ONE pixel in the destination mip
    uint2 dst = id.xy;

    // Destination mip is half resolution of source (minimum 1)
    uint dstWidth = max(1u, (uint) _SrcMipSizeX / 2u);
    uint dstHeight = max(1u, (uint) _SrcMipSizeY / 2u);

    // Kill threads outside the valid destination range
    if (dst.x >= dstWidth || dst.y >= dstHeight)
        return;

    // Map this destination pixel to a 2x2 block in the source mip
    uint2 src00 = dst * 2;
    uint2 src10 = src00 + uint2(1, 0);
    uint2 src01 = src00 + uint2(0, 1);
    uint2 src11 = src00 + uint2(1, 1);

    // Clamp for odd source sizes (e.g. 527 → 263)
    src10.x = min(src10.x, (uint) (_SrcMipSizeX - 1));
    src01.y = min(src01.y, (uint) (_SrcMipSizeY - 1));
    src11.x = min(src11.x, (uint) (_SrcMipSizeX - 1));
    src11.y = min(src11.y, (uint) (_SrcMipSizeY - 1));

    // Read from the source array slice at the source mip level
    float h00 = _SrcTex.Load(int4(src00, _SrcSlice, _SrcMip));
    float h10 = _SrcTex.Load(int4(src10, _SrcSlice, _SrcMip));
    float h01 = _SrcTex.Load(int4(src01, _SrcSlice, _SrcMip));
    float h11 = _SrcTex.Load(int4(src11, _SrcSlice, _SrcMip));

    _DstTex[uint3(dst, _DstSlice)] = max(max(h00, h10), max(h01, h11));
}
